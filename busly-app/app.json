{
  "expo": {
    "name": "Busly",
    "slug": "busly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./busly.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#4F46E5"
    },
    "android": {
      "package": "app.busly.mobile",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "ios": {
      "bundleIdentifier": "app.busly.mobile",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Busly uses your location to show live bus tracking during trips."
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Busly uses your location to show live bus tracking during trips."
        }
      ]
    ]
  }
}
