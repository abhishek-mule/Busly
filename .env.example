# Copy to .env on the host if you want to override compose defaults.
# The compose file itself carries working defaults; only set these when deploying.

# --- Backend (host machine running docker compose) ---
# Comma-separated origins allowed to call the API (admin dashboard domain).
# Example: ALLOWED_ORIGINS=https://busly-admin.vercel.app
ALLOWED_ORIGINS=*

# JWT keys must exist on the host (mounted into containers as /etc/keys).
# Generate with: sudo ./scripts/gen-keys.sh
JWT_PRIVATE_KEY_PATH=/etc/keys/private.pem
JWT_PUBLIC_KEY_PATH=/etc/keys/public.pem

# Postgres/Redis passwords used by compose (change for production).
DB_PASSWORD=password

# --- Admin dashboard (Vercel -> Settings -> Environment Variables) ---
# Point at your PUBLIC backend URL, e.g. https://api.yourdomain.com/api/v1
# (Cloudflare Tunnel gives you this for free, no open ports needed.)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Mobile app (set in your shell BEFORE `eas build`, baked into the APK) ---
# Same public backend URL, e.g. https://api.yourdomain.com/api/v1
EXPO_PUBLIC_API_URL=http://192.168.1.3:8000/api/v1

# Google Maps key for release-build map tiles (Android). Free tier with
# $200/mo credit (requires a billing account to enable):
# https://developers.google.com/maps/documentation/android-sdk/cloud-setup
# Without it the release APK shows a blank map grid.
GOOGLE_MAPS_API_KEY=
