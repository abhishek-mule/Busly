# Database
DATABASE_URL=postgresql://busly:password@localhost:5432/busly
SHARED_DB_URL=postgresql://busly:password@localhost:5432/busly

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# JWT
JWT_PRIVATE_KEY_PATH=/etc/keys/private.pem
JWT_PUBLIC_KEY_PATH=/etc/keys/public.pem

# API
API_PORT=8000
API_HOST=0.0.0.0

# Services
AUTH_SERVICE_PORT=8001
FLEET_SERVICE_PORT=8002
ROUTING_SERVICE_PORT=8003
STUDENT_SERVICE_PORT=8004
GEO_SERVICE_PORT=8005
TENANT_SERVICE_PORT=8006
NOTIFICATION_SERVICE_PORT=8008
AI_SERVICE_PORT=8009

# OpenAI (for AI Chatbot)
OPENAI_API_KEY=your-openai-api-key

# App
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8005/ws
