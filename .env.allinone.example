# All-in-one backend: ONE container (gateway + 8 services + Celery worker).
# Image: backend/Dockerfile.allinone (listens on port 8000 only).
# Pair with free Neon Postgres (PostGIS) + free Upstash Redis.
# The platform only needs: this env + Dockerfile + port 8000. No Compose.

# ---------- databases (free tiers) ----------
# Neon Postgres (enable PostGIS there once: CREATE EXTENSION postgis;).
# Neon requires SSL: keep ?sslmode=require on the URLs.
SHARED_DB_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require
ASYNC_PREFIX=postgresql+asyncpg://USER:PASSWORD@HOST
DB_USER=USER
DB_PASSWORD=PASSWORD
DB_HOST=HOST
DB_PORT=5432
# Upstash Redis uses TLS (rediss://). Celery rides Redis as its broker,
# so RabbitMQ is NOT needed in all-in-one mode.
REDIS_URL=rediss://default:PASSWORD@HOST:6379
BROKER_URL=rediss://default:PASSWORD@HOST:6379/0
RESULT_BACKEND=rediss://default:PASSWORD@HOST:6379/0

# ---------- internal services: same container, keep localhost ----------
BUSLY_AUTH_URL=http://127.0.0.1:8001
BUSLY_FLEET_URL=http://127.0.0.1:8002
BUSLY_ROUTING_URL=http://127.0.0.1:8003
BUSLY_STUDENT_URL=http://127.0.0.1:8004
BUSLY_GEO_URL=http://127.0.0.1:8005
BUSLY_TENANT_URL=http://127.0.0.1:8006
BUSLY_NOTIFICATION_URL=http://127.0.0.1:8008

# ---------- JWT keys as text (paste full PEM including BEGIN/END lines) ----------
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----

# ---------- misc ----------
ALLOWED_ORIGINS=https://your-admin-app.vercel.app
